{
  "name": "Artifax",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "homepage": ".",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.11.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "electron-squirrel-startup": "^1.0.1",
    "postcss": "^8.5.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.28.2",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "electron-forge start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:coverage": "cross-env CI=true react-scripts test --coverage --watchAll=false --runInBand",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx,js,jsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx,js,jsx}",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**",
      "!src/test-utils/**",
      "!src/index.tsx",
      "!src/App.tsx",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/hooks/index.ts",
      "!src/data/fallback.ts",
      "!src/config/navigation.ts",
      "!src/pages/crafting/components/craftingData.ts",
      "!src/pages/crafting/components/historyData.ts",
      "!src/components/common/**",
      "!src/components/layout/PageHeader.tsx",
      "!src/layouts/AppLayout.tsx",
      "!src/pages/crafting/components/craftingNav/**",
      "!src/pages/auth/OtpVerifySuccessPage.tsx",
      "!src/pages/auth/OtpVerifyFailedPage.tsx",
      "!src/forceLogin/**",
      "!src/pages/navbar/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "daisyui": "^4.12.22",
    "electron": "^42.3.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  }
}
